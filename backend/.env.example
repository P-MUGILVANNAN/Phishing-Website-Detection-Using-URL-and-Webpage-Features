ENVIRONMENT=development
PROJECT_NAME=PhishGuard AI
VERSION=1.0.0
API_PREFIX=/api
DATABASE_URL=sqlite:///./phishguard.db
ARTIFACTS_DIR=./artifacts
ENABLE_WEBPAGE_FETCH=false
SAFE_FETCH_TIMEOUT_SECONDS=6
SAFE_FETCH_MAX_BYTES=524288
SAFE_FETCH_MAX_REDIRECTS=3
THRESHOLD_LEGITIMATE=0.30
THRESHOLD_PHISHING=0.70
ADMIN_API_KEY=dev-secret-key
FEATURE_SCHEMA_VERSION=1.0.0

