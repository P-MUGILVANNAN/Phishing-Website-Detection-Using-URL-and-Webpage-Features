# PhishGuard AI - Application Configuration Template
ENVIRONMENT=development
PROJECT_NAME=PhishGuard AI
VERSION=1.0.0
API_PREFIX=/api

# Database & Artifacts
DATABASE_URL=sqlite:///./phishguard.db
ARTIFACTS_DIR=./artifacts

# SSRF-Guarded Safe Fetching Controls
ENABLE_WEBPAGE_FETCH=false
SAFE_FETCH_TIMEOUT_SECONDS=6.0
SAFE_FETCH_MAX_BYTES=524288
SAFE_FETCH_MAX_REDIRECTS=3

# Classification & Uncertainty Threshold Policy
THRESHOLD_LEGITIMATE=0.30
THRESHOLD_PHISHING=0.70

# Authentication & Feature Schema
ADMIN_API_KEY=your-admin-secret-key-here
FEATURE_SCHEMA_VERSION=1.0.0

# Network & Ports
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api

